{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/runtime-and-admin-auth": false,
      "fix/server-jose-compatibility": false,
      "chore/wif-readonly-preflight": false,
      "feat/calendar-agent-grants": false,
      "feat/google-calendar-view": false,
      "feat/calendar-interactive-ui": false,
      "feat/chatgpt-mcp-oauth": false,
      "feat/mcp-client-crud": false,
      "fix/legacy-rules-and-mcp-pilot": false,
      "fix/oauth-ui-locales": false,
      "fix/oauth-vercel-form-body": false,
      "test/firebase-oauth-emulator-crud": false
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp-auth?action=metadata"
    },
    { "source": "/oauth/:action", "destination": "/api/mcp-auth?action=:action" },
    { "source": "/mcp/consent", "destination": "/index.html" },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/mcp-oauth-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp-oauth-metadata"
    }
  ],
  "headers": [
    {
      "source": "/mcp/consent",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
