{
  "name": "小螞蟻專案看板",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "vitest run",
    "test:rules": "firebase emulators:exec --config security/firebase.emulators.json --project demo-antty-security --only firestore,storage \"node --import tsx --test --test-concurrency=1 tests/security/*.test.ts\"",
    "postinstall": "patch-package --error-on-fail --error-on-warn"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "6.1.20",
    "@fullcalendar/daygrid": "6.1.20",
    "@fullcalendar/interaction": "6.1.20",
    "@fullcalendar/react": "6.1.20",
    "@fullcalendar/timegrid": "6.1.20",
    "@google-cloud/firestore": "^9.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/oidc": "^4.0.6",
    "@xyflow/react": "^12.12.1",
    "firebase": "^12.6.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.3",
    "jose": "^6.2.15",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.34.2",
    "globals": "^17.6.0",
    "jsdom": "^30.1.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "protobufjs": "^7.6.6",
    "websocket-driver": "^0.7.5"
  },
  "engines": {
    "node": ">=22"
  }
}
