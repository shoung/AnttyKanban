VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=antboard-2025.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=antboard-2025
VITE_FIREBASE_STORAGE_BUCKET=antboard-2025.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=376367007034
VITE_FIREBASE_APP_ID=1:376367007034:web:fdd96864c9d9603e20fc03
VITE_FIREBASE_MEASUREMENT_ID=G-JMC7203YRN

# Server only: production uses explicitly approved Vercel OIDC → Google WIF.
# Never prefix any server secret with VITE_. Never commit credential files.
FIREBASE_PROJECT_ID=antboard-2025
FIREBASE_ADMIN_AUTH_MODE=vercel-wif
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# Optional Calendar backend: callback is {CALENDAR_APP_ORIGIN}/api/calendar?action=callback
CALENDAR_APP_ORIGIN=
GOOGLE_CALENDAR_PROJECT_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# A 32-byte key encoded as base64. Configure through your approved secret store.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Optional MCP PAT backend. Off until deployment configuration has been reviewed.
ANTTY_MCP_ENABLED=false
ANTTY_APP_ORIGIN=

# Separate AI/agent Google OAuth client and grant. Never reuse the UI client/project/key.
# Agent callback: {CALENDAR_APP_ORIGIN}/api/calendar-agent?action=callback
GOOGLE_CALENDAR_AGENT_PROJECT_ID=
GOOGLE_CALENDAR_AGENT_CLIENT_ID=
GOOGLE_CALENDAR_AGENT_CLIENT_SECRET=
CALENDAR_AGENT_TOKEN_ENCRYPTION_KEY=
# Set only after verifying Google Console marks this client for AI-powered agents.
GOOGLE_CALENDAR_AGENT_CLIENT_CONFIRMED=false

# Optional managed OAuth resource server. Disabled until provider and verified
# Legacy alternative only. Keep both managed OAuth/link flags false for Firebase OAuth.
# Firebase identity linking are separately configured and reviewed. No secrets here.
ANTTY_MCP_OAUTH_ENABLED=false
# Exact HTTPS issuer and same-origin JWKS URI. Preserve the issuer's trailing slash.
ANTTY_MCP_OAUTH_ISSUER=
ANTTY_MCP_OAUTH_JWKS_URI=
# JSON array of explicitly approved OAuth client IDs. No open DCR auto-allowing.
ANTTY_MCP_OAUTH_CLIENT_IDS=[]
# Start read-only. Issuer scopes, this ceiling, and the account binding must all agree.
ANTTY_MCP_OAUTH_SCOPES=maps:read
# RFC 9068 access tokens (typ at+jwt, client_id, jti); RS256 default, ES256 supported.
ANTTY_MCP_OAUTH_ALGORITHM=RS256

# Optional personal Auth0/Firebase identity link. Separate PUBLIC PKCE application,
# token_endpoint_auth_method=none; no Management API key or linking client secret.
# Exact callback: {ANTTY_APP_ORIGIN}/api/mcp-link?action=callback
# Fixed maps:read / seven days, one allowlisted MCP client. No refresh tokens.
ANTTY_MCP_LINK_ENABLED=false
ANTTY_MCP_LINK_CLIENT_ID=

# Selected Firebase-backed, first-party MCP OAuth. No Auth0, signing key or client secret.
# All flags stay false until deployment, actual callback/client and test identity are approved.
ANTTY_MCP_FIREBASE_OAUTH_ENABLED=false
# Fixed public clients JSON: [{"id":"<approved-public-id>","name":"ChatGPT","redirectUris":["<exact HTTPS callback from actual ChatGPT setup>"]}]
ANTTY_MCP_FIREBASE_OAUTH_CLIENTS=[]
ANTTY_MCP_FIREBASE_OAUTH_SCOPES=maps:read
